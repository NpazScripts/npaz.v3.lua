MakeToggleCard(MenuFrame, 72, "Inf Jump", "B",
    function() infJumpEnabled = true  end,
    function() infJumpEnabled = false end
)
 
-- ==================== LEFT CTRL — TOGGLE PAINEL ====================
local panelVisible = true
local panelTween = TweenInfo.new(0.2, Enum.EasingStyle.Quad)
 
UserInputService.InputBegan:Connect(function(input, gpe)
    if input.KeyCode == Enum.KeyCode.LeftControl then
        panelVisible = not panelVisible
        if panelVisible then
            MainFrame.Visible = true
            TweenService:Create(MainFrame, panelTween, {Size = UDim2.new(0, 560, 0, 420)}):Play()
        else
            local t = TweenService:Create(MainFrame, panelTween, {Size = UDim2.new(0, 560, 0, 0)})
            t:Play()
            t.Completed:Connect(function()
                if not panelVisible then MainFrame.Visible = false end
            end)
        end
    end
end)
 
